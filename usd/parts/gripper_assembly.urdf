<?xml version="1.0"?>
<!--
  Gripper Assembly URDF
  - 좌표계: 플랜지 마운트 면 = 원점 (Y=0)
  - 단위: 미터 (STL은 mm → scale=0.001)
  - gripper_base_link → gripper_left_link  (prismatic, -X 방향으로 열림)
  - gripper_base_link → gripper_right_link (prismatic, +X 방향으로 열림)
  - M1013 tool0에 fixed joint로 연결 시: rpy="0 0 0" 방향 확인 필요
-->
<robot name="gripper_assembly">

  <!-- ── 몸체 ── -->
  <link name="gripper_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="gripper_body_urdf.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.5 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="gripper_body_urdf.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0.0 -0.0545 -0.006" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ── 왼쪽 플레이트 ── -->
  <link name="gripper_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="gripper_left_urdf.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.5 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="gripper_left_urdf.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- ── 오른쪽 플레이트 ── -->
  <link name="gripper_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="gripper_right_urdf.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 0.8 0.4 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="gripper_right_urdf.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- ── 왼쪽 조인트: -X 방향으로 열림 ── -->
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_left_link"/>
    <origin xyz="-0.0445 -0.1280 -0.0002" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0.0" upper="0.036" effort="50.0" velocity="0.1"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- ── 오른쪽 조인트: +X 방향으로 열림 (left와 대칭) ── -->
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_right_link"/>
    <origin xyz="0.0445 -0.1277 -0.0017" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.036" effort="50.0" velocity="0.1"/>
    <dynamics damping="0.5" friction="0.1"/>
    <mimic joint="gripper_left_joint" multiplier="1.0" offset="0.0"/>
  </joint>

</robot>
